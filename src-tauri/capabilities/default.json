{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana de Brote",
  "windows": [
    "pet",
    "bubble",
    "confirm",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:menu:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://openrouter.ai/*"
        },
        {
          "url": "https://github.com/lukas-code-master-ctp/project-clippy/*"
        }
      ]
    }
  ]
}
